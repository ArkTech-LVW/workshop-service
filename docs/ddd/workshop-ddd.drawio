        <mxCell id="es-stock-91" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=2;fontColor=#555555;verticalAlign=top;" value="O estoque reage aos eventos da OS na mesma transação: se ele recusa, o comando da OS é desfeito. A conta é sempre pela diferença do que já saiu para a OS, por isso o orçamento complementar reserva e baixa só o que mudou." vertex="1">
          <mxGeometry height="110" width="600" x="1700" y="1100" as="geometry" />
