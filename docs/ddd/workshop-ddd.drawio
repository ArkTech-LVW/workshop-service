          <mxGeometry x="2510" y="440" width="170" height="150" as="geometry" />
        </mxCell>
        <mxCell id="es-create-66" value="Serviço removido" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#f5a623;strokeColor=#b97a00;" vertex="1" parent="1">
          <mxGeometry x="2510" y="620" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-67" value="Mecânico ou atendente" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#fff9b1;strokeColor=#b8a93a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2730" y="320" width="100" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-68" value="Remover peça ou insumo&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;i&gt;RemovePartItemUseCase&lt;/i&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#26c6da;strokeColor=#0097a7;" vertex="1" parent="1">
          <mxGeometry x="2850" y="320" width="170" height="90" as="geometry" />
