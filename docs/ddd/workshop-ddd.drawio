        <mxCell id="es-create-15" value="Agregado" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="190" height="150" as="geometry" />
        </mxCell>
        <mxCell id="es-create-16" value="Evento" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-17" value="Regras de negócio" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="830" width="190" height="40" as="geometry" />
        </mxCell>
        <mxCell id="es-create-18" value="Pontos de atenção" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="1050" width="190" height="40" as="geometry" />
        </mxCell>
        <mxCell id="es-create-19" value="Cliente por CPF/CNPJ&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;GET /admin/customers?document=&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#8bc34a;strokeColor=#558b2f;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="390" y="200" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="es-create-20" value="Atendente" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#fff9b1;strokeColor=#b8a93a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="270" y="320" width="100" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-21" value="Cadastrar cliente&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;i&gt;CreateCustomerUseCase&lt;/i&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#26c6da;strokeColor=#0097a7;" vertex="1" parent="1">
          <mxGeometry x="390" y="320" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-22" value="Cliente" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#fff9b1;strokeColor=#b8a93a;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="390" y="440" width="170" height="150" as="geometry" />
        </mxCell>
        <mxCell id="es-create-23" value="Cliente cadastrado" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#f5a623;strokeColor=#b97a00;" vertex="1" parent="1">
          <mxGeometry x="390" y="620" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-24" value="• CPF ou CNPJ com dígitos verificadores válidos.&lt;br&gt;• Um cliente por CPF/CNPJ (409).&lt;br&gt;• Nome e e-mail obrigatórios; telefone opcional.&lt;br&gt;• Atendente e administrador cadastram e listam clientes." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#8e44ad;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="830" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="es-create-25" value="Veículo por placa&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;GET /admin/vehicles?licensePlate=&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#8bc34a;strokeColor=#558b2f;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="730" y="200" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="es-create-26" value="Atendente" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#fff9b1;strokeColor=#b8a93a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="610" y="320" width="100" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-27" value="Cadastrar veículo&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;i&gt;CreateVehicleUseCase&lt;/i&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#26c6da;strokeColor=#0097a7;" vertex="1" parent="1">
          <mxGeometry x="730" y="320" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-28" value="Veículo" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#fff9b1;strokeColor=#b8a93a;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="730" y="440" width="170" height="150" as="geometry" />
        </mxCell>
        <mxCell id="es-create-29" value="Veículo cadastrado" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#f5a623;strokeColor=#b97a00;" vertex="1" parent="1">
          <mxGeometry x="730" y="620" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-30" value="• Placa no padrão antigo ou Mercosul, única (409).&lt;br&gt;• Chassi opcional e único.&lt;br&gt;• Ano de 1981 até o ano que vem.&lt;br&gt;• Marca, modelo e cor obrigatórios.&lt;br&gt;• Na abertura da OS, a placa sem cadastro é cadastrada para o cliente." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#8e44ad;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="830" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="es-create-31" value="Placa já cadastrada para o cliente: a abertura reaproveita o veículo e ignora a marca, o modelo, o ano e a cor enviados." style="rhombus;whiteSpace=wrap;html=1;fillColor=#f08080;strokeColor=#b85450;fontSize=11;spacingLeft=52;spacingRight=52;" vertex="1" parent="1">
          <mxGeometry x="600" y="1050" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="es-create-32" value="OS do cliente ou da placa&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;GET /admin/serviceOrders?customerDocument= ou licensePlate=&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#8bc34a;strokeColor=#558b2f;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1110" y="200" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="es-create-33" value="Atendente" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#fff9b1;strokeColor=#b8a93a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="990" y="320" width="100" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-34" value="Abrir OS&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;i&gt;OpenServiceOrderUseCase&lt;/i&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#26c6da;strokeColor=#0097a7;" vertex="1" parent="1">
          <mxGeometry x="1110" y="320" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-35" value="Ordem de Serviço" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#fff9b1;strokeColor=#b8a93a;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1110" y="440" width="170" height="150" as="geometry" />
        </mxCell>
        <mxCell id="es-create-36" value="&lt;b&gt;OS aberta&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;i&gt;status Recebida&lt;/i&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#f5a623;strokeColor=#b97a00;" vertex="1" parent="1">
          <mxGeometry x="1110" y="620" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-37" value="• Identifica o cliente pelo CPF/CNPJ; sem cadastro, 404.&lt;br&gt;• Placa de outro cliente, 409.&lt;br&gt;• Descrição do problema obrigatória.&lt;br&gt;• Número sequencial por ano: SO-2026-000001.&lt;br&gt;• Começa Recebida, com quem abriu no histórico de status." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#8e44ad;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="830" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="es-create-38" value="Veículo que trocou de dono não abre OS: a placa é de outro cliente (409) e não há transferência." style="rhombus;whiteSpace=wrap;html=1;fillColor=#f08080;strokeColor=#b85450;fontSize=11;spacingLeft=52;spacingRight=52;" vertex="1" parent="1">
          <mxGeometry x="980" y="1050" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="es-create-39" value="Nada impede abrir uma segunda OS para um veículo que já tem uma OS em andamento." style="rhombus;whiteSpace=wrap;html=1;fillColor=#f08080;strokeColor=#b85450;fontSize=11;spacingLeft=52;spacingRight=52;" vertex="1" parent="1">
          <mxGeometry x="980" y="1260" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="es-create-40" value="OS recebidas&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;GET /admin/serviceOrders?status=RECEIVED&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#8bc34a;strokeColor=#558b2f;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1490" y="200" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="es-create-41" value="Mecânico" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#fff9b1;strokeColor=#b8a93a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1370" y="320" width="100" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-42" value="Iniciar diagnóstico&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;i&gt;StartDiagnosisUseCase&lt;/i&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#26c6da;strokeColor=#0097a7;" vertex="1" parent="1">
          <mxGeometry x="1490" y="320" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-43" value="Ordem de Serviço" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#fff9b1;strokeColor=#b8a93a;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1490" y="440" width="170" height="150" as="geometry" />
        </mxCell>
        <mxCell id="es-create-44" value="Diagnóstico iniciado&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;i&gt;status Em diagnóstico&lt;/i&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#f5a623;strokeColor=#b97a00;" vertex="1" parent="1">
          <mxGeometry x="1490" y="620" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-45" value="• Só a partir de Recebida.&lt;br&gt;• Quem inicia vira o mecânico da OS.&lt;br&gt;• Vai para Em diagnóstico, com registro no histórico." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#8e44ad;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1360" y="830" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="es-create-46" value="Mecânico inicia o diagnóstico, mas não lista nem consulta a OS: as consultas são só do administrador e do atendente." style="rhombus;whiteSpace=wrap;html=1;fillColor=#f08080;strokeColor=#b85450;fontSize=11;spacingLeft=52;spacingRight=52;" vertex="1" parent="1">
          <mxGeometry x="1360" y="1050" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="es-create-47" value="O diagnóstico não guarda o que foi encontrado: só muda o status e define o mecânico." style="rhombus;whiteSpace=wrap;html=1;fillColor=#f08080;strokeColor=#b85450;fontSize=11;spacingLeft=52;spacingRight=52;" vertex="1" parent="1">
          <mxGeometry x="1360" y="1260" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="es-create-48" value="Serviços ativos do catálogo&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;GET /admin/services?active=true&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#8bc34a;strokeColor=#558b2f;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1830" y="200" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="es-create-49" value="Mecânico ou atendente" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#fff9b1;strokeColor=#b8a93a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1710" y="320" width="100" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-50" value="Incluir serviço&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;i&gt;AddServiceItemUseCase&lt;/i&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#26c6da;strokeColor=#0097a7;" vertex="1" parent="1">
          <mxGeometry x="1830" y="320" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-51" value="Ordem de Serviço" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#fff9b1;strokeColor=#b8a93a;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1830" y="440" width="170" height="150" as="geometry" />
        </mxCell>
        <mxCell id="es-create-52" value="Serviço incluído" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#f5a623;strokeColor=#b97a00;" vertex="1" parent="1">
          <mxGeometry x="1830" y="620" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-53" value="• Itens só mudam em Recebida e Em diagnóstico; no complementar, também em execução e com o complementar rejeitado.&lt;br&gt;• Serviço desativado no catálogo não entra (422).&lt;br&gt;• Preço: mão de obra do catálogo na hora da inclusão.&lt;br&gt;• Quantidade de 1 a 999." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#8e44ad;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1700" y="830" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="es-create-54" value="Mecânico e atendente não consultam serviços nem peças (rotas só do administrador) e incluem o item pelo id." style="rhombus;whiteSpace=wrap;html=1;fillColor=#f08080;strokeColor=#b85450;fontSize=11;spacingLeft=52;spacingRight=52;" vertex="1" parent="1">
          <mxGeometry x="1700" y="1050" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="es-create-55" value="Peças e insumos com disponível&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;GET /admin/parts&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#8bc34a;strokeColor=#558b2f;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2170" y="200" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="es-create-56" value="Mecânico ou atendente" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#fff9b1;strokeColor=#b8a93a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2050" y="320" width="100" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-57" value="Incluir peça ou insumo&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;i&gt;AddPartItemUseCase&lt;/i&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#26c6da;strokeColor=#0097a7;" vertex="1" parent="1">
          <mxGeometry x="2170" y="320" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-58" value="Ordem de Serviço" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#fff9b1;strokeColor=#b8a93a;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="2170" y="440" width="170" height="150" as="geometry" />
        </mxCell>
        <mxCell id="es-create-59" value="Peça incluída" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#f5a623;strokeColor=#b97a00;" vertex="1" parent="1">
          <mxGeometry x="2170" y="620" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-60" value="• Mesmos status da inclusão de serviço.&lt;br&gt;• Preço: preço de venda do estoque na hora da inclusão.&lt;br&gt;• Só entra se o disponível (estoque menos reservado) cobre a soma da peça na OS, descontado o que já saiu para ela (422).&lt;br&gt;• Confere o disponível, mas não reserva." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#8e44ad;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2040" y="830" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="es-create-61" value="A peça só é reservada no envio: entre a inclusão e o envio, outra OS pode reservá-la." style="rhombus;whiteSpace=wrap;html=1;fillColor=#f08080;strokeColor=#b85450;fontSize=11;spacingLeft=52;spacingRight=52;" vertex="1" parent="1">
          <mxGeometry x="2040" y="1050" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="es-create-62" value="Itens e total da OS&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;GET /admin/serviceOrders/{id}&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#8bc34a;strokeColor=#558b2f;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2510" y="200" width="510" height="80" as="geometry" />
        </mxCell>
        <mxCell id="es-create-63" value="Mecânico ou atendente" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#fff9b1;strokeColor=#b8a93a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2390" y="320" width="100" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-64" value="Remover serviço&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;i&gt;RemoveServiceItemUseCase&lt;/i&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#26c6da;strokeColor=#0097a7;" vertex="1" parent="1">
          <mxGeometry x="2510" y="320" width="170" height="90" as="geometry" />
        </mxCell>
