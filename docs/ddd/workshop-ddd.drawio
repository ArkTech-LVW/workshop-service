        <mxCell id="ubiquitous-12" value="&lt;b style=&quot;font-size:18px&quot;&gt;Núcleo compartilhado&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:12px&quot;&gt;Objetos de valor comuns&lt;/i&gt;&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:12px;margin-top:8px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;text-align:left;border-bottom:2px solid #000000;padding:3px 4px;width:25%&quot;&gt;Termo&lt;/th&gt;&lt;th style=&quot;text-align:left;border-bottom:2px solid #000000;padding:3px 4px;width:28%&quot;&gt;Nome no código&lt;/th&gt;&lt;th style=&quot;text-align:left;border-bottom:2px solid #000000;padding:3px 4px;width:47%&quot;&gt;Definição&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Dinheiro&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;Money&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Valor em reais com duas casas decimais&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;CPF / CNPJ / CPF ou CNPJ&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;CPF&lt;/font&gt; / &lt;font face=&quot;Courier New&quot;&gt;CNPJ&lt;/font&gt; / &lt;font face=&quot;Courier New&quot;&gt;CPFCNPJ&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Documento de pessoa física / jurídica / qualquer um dos dois&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;E-mail / Telefone&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&g