          <mxGeometry x="245" y="160" width="670" height="630" as="geometry" />
        </mxCell>
        <mxCell id="es-create-7" value="Ordem de Serviço" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;dashed=1;strokeWidth=2;fillColor=none;strokeColor=#333333;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="965" y="160" width="2750" height="630" as="geometry" />
