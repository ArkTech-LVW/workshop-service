        <mxCell id="legend-40" value="Fora da solução." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1080" y="702" width="460" height="44" as="geometry" />
        </mxCell>
        <mxCell id="legend-41" value="&lt;b&gt;U / D:&lt;/b&gt; Upstream (fornecedor) fornece; Downstream (cliente) depende.&lt;br&gt;&lt;b&gt;Cliente-Fornecedor:&lt;/b&gt; o fornecedor expõe um contrato para o cliente.&lt;br&gt;&lt;b&gt;Conformista (Conforma):&lt;/b&gt; o cliente adota o modelo do fornecedor sem traduzi-lo.&lt;br&gt;&lt;b&gt;ACL (Camada Anti-Corrupção):&lt;/b&gt; traduz o fornecedor externo e protege o contexto de mudanças nele.&lt;br&gt;&lt;b&gt;Kernel Compartilhado:&lt;/b&gt; pequena parte do modelo comum a vários contextos; quanto menor, melhor." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="760" width="720" height="120" as="geometry" />
        </mxCell>
        <mxCell id="legend-42" value="Termos que podem confundir" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="900" width="600" height="36" as="geometry" />
        </mxCell>
        <mxCell id="legend-43" value="&lt;b&gt;Contexto do C4&lt;/b&gt; é a visão do sistema e do seu entorno; não é um Bounded Context.&lt;br&gt;&lt;b&gt;Contêiner do C4&lt;/b&gt; é uma parte executável ou um banco de dados; não é necessariamente um contêiner Docker.&lt;br&gt;&lt;b&gt;Componente do C4&lt;/b&gt; é um módulo interno de um contêiner.&lt;br&gt;Cada diagrama C4 traz a sua própria legenda." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="945" width="720" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
