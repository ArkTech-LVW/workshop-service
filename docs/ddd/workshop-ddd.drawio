        </mxCell>
        <mxCell id="tactical-5" value="Agregado &lt;b&gt;ServiceOrder&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#b8a93a;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=13;fontColor=#6b5f00;" vertex="1" parent="1">
          <mxGeometry x="290" y="210" width="790" height="790" as="geometry" />
