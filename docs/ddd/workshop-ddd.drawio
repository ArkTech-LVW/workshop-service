        <mxCell id="es-parts-381" value="Peça ou insumo" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;spacingTop=14;fillColor=#fff9b1;strokeColor=#b8a93a;fontSize=16;fontStyle=1;" vertex="1" parent="1">
