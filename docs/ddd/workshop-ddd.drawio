        <mxCell id="ubiquitous-3" value="&lt;b style=&quot;font-size:18px&quot;&gt;Ordem de Serviço&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:12px&quot;&gt;Subdomínio principal&lt;/i&gt;&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:12px;margin-top:8px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;text-align:left;border-bottom:2px solid #000000;padding:3px 4px&quot;&gt;Termo&lt;/th&gt;&lt;th style=&quot;text-align:left;border-bottom:2px solid #000000;padding:3px 4px&quot;&gt;Nome no código&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Ordem de Serviço (OS)&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;ServiceOrder&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Número da OS&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;ServiceOrderNumber&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Código de acompanhamento&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;publicId&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Descrição do problema&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;problemDescription&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Diagnóstico&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;diagnosis&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Mecânico responsável&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;mechanic&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Item da OS&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;ServiceOrderItem&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Item de serviço&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;ServiceItem&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Item de peça&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;PartItem&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Preço unitário&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;unitPrice&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Valor total&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;totalPrice&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Orçamento&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;quote&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Item aprovado&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;approvedItem&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Etapa do item no orçamento&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;QuoteItemStage&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Orçamento complementar&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;supplementaryQuote&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Pode seguir sem as mudanças&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;canProceedWithoutChanges&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Motivo&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;reason&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Histórico de status&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;StatusChange&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Cliente (ator, sem login)&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;customer&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="640" height="611" as="geometry" />
        </mxCell>
        <mxCell id="ubiquitous-4" value="&lt;b style=&quot;font-size:18px&quot;&gt;Status da OS&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:12px&quot;&gt;ServiceOrderStatus&lt;/i&gt;&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:12px;margin-top:8px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;text-align:left;border-bottom:2px solid #000000;padding:3px 4px&quot;&gt;Código&lt;/th&gt;&lt;th style=&quot;text-align:left;border-bottom:2px solid #000000;padding:3px 4px&quot;&gt;Termo&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;RECEIVED&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Recebida&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;IN_DIAGNOSIS&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Em diagnóstico&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;AWAITING_APPROVAL&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Aguardando aprovação&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;QUOTE_APPROVED&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Orçamento aprovado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;QUOTE_REJECTED&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Orçamento rejeitado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;IN_PROGRESS&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Em execução&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;AWAITING_SUPPLEMENTARY_APPROVAL&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Aguardando o complementar&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;SUPPLEMENTARY_APPROVED&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Complementar aprovado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;SUPPLEMENTARY_REJECTED&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Complementar rejeitado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;COMPLETED&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Finalizada&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;DELIVERED&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Entregue&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;CANCELED&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Cancelada&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="740" y="130" width="600" height="411" as="geometry" />
        </mxCell>
        <mxCell id="ubiquitous-5" value="&lt;b style=&quot;font-size:18px&quot;&gt;Termos que mudam de significado entre contextos&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:12px&quot;&gt;Mesmo nome, conceitos diferentes&lt;/i&gt;&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:12px;margin-top:8px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;text-align:left;border-bottom:2px solid #000000;padding:3px 4px&quot;&gt;Termo&lt;/th&gt;&lt;th style=&quot;text-align:left;border-bottom:2px solid #000000;padding:3px 4px&quot;&gt;Em um contexto&lt;/th&gt;&lt;th style=&quot;text-align:left;border-bottom:2px solid #000000;padding:3px 4px&quot;&gt;Em outro&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;b&gt;Serviço&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Catálogo: serviço oferecido, com preço e tempo estimado (&lt;font face=&quot;Courier New&quot;&gt;ServiceOffering&lt;/font&gt;)&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;OS: linha da OS, com aprovação, início e conclusão (&lt;font face=&quot;Courier New&quot;&gt;ServiceItem&lt;/font&gt;)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;b&gt;Peça&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Estoque: item com SKU, quantidades e reservas (&lt;font face=&quot;Courier New&quot;&gt;Part&lt;/font&gt;); peça ou insumo&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;OS: linha da OS com quantidade e preço (&lt;font face=&quot;Courier New&quot;&gt;PartItem&lt;/font&gt;)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;b&gt;Preço&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Catálogo: mão de obra; Estoque: preço de venda&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;OS: preço unitário copiado na inclusão&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;b&gt;Cliente&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Cadastro: registro com documento e contatos (&lt;font face=&quot;Courier New&quot;&gt;Customer&lt;/font&gt;)&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;OS: ator sem login; Notificações: destinatário&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;b&gt;Usuário&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Identidade e Acesso: conta com perfis e senha (&lt;font face=&quot;Courier New&quot;&gt;User&lt;/font&gt;)&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;OS: quem fez a ação; sem usuário = decisão do cliente&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;b&gt;Aprovação&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;OS: cliente ou oficina aceita o orçamento&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Estoque: administrador aceita um pedido de ajuste&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;b&gt;Concluído&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;borde