        <mxCell id="es-stock-89" parent="es-stock-88" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontStyle=1;spacingLeft=0;spacingTop=1;connectable=0;" value="PA" vertex="1">
