        </mxCell>
        <mxCell id="es-stock-93" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;" value="Os mesmos comandos e eventos, agrupados pelo agregado que os trata, com as setas do fluxo. A caixa tracejada é o contexto delimitado. A caixa Ordem de Serviço mostra de onde vêm os eventos que o estoque escuta." vertex="1">
          <mxGeometry height="30" width="2400" x="40" y="2178" as="geometry" />
        </mxCell>
