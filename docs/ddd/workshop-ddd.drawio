        <mxCell id="tactical-4" value="&lt;b style=&quot;font-size:18px&quot;&gt;Ordem de Serviço&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;i style=&quot;font-size:12px&quot;&gt;Subdomínio principal · pacote &lt;code&gt;serviceorder&lt;/code&gt;&lt;/i&gt;" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;dashed=1;strokeWidth=2;fillColor=none;strokeColor=#333333;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;" vertex="1" parent="1">
