        </mxCell>
        <mxCell id="es-track-601" parent="es-track-600" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontStyle=1;spacingLeft=4;spacingTop=1;connectable=0;" value="CMD" vertex="1">
