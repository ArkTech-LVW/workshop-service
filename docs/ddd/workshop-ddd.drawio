        <mxCell id="es-parts-206" value="Ajuste é a correção depois da contagem do estoque. O administrador ajusta direto; o atendente pede, e um administrador aprova ou recusa. Quem pede nunca revisa o próprio pedido." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="3090" y="1880" width="900" height="60" as="geometry" />
        </mxCell>
        <mxCell id="es-parts-207" value="2. Agregados e contextos delimitados" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="2220" width="900" height="34" as="geometry" />
        </mxCell>
        <mxCell id="es-parts-208" value="Os mesmos comandos e eventos, agrupados pelo agregado que os trata. A caixa tracejada é o contexto delimitado. A caixa Ordem de Serviço mostra de onde vêm os eventos que o estoque escuta." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="2258" width="2400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="es-parts-209" value="Ordem de Serviço" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;dashed=1;strokeWidth=2;fillColor=none;strokeColor=#333333;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="2320" width="860" height="830" as="geometry" />
        </mxCell>
