        <mxCell id="es-create-13" value="Modelo de leitura" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="es-create-14" value="Ator ou política e comando" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="190" height="90" as="geometry" />
