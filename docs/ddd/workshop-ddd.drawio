        <mxCell id="es-create-9" value="Notificações" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;dashed=1;strokeWidth=2;fillColor=none;strokeColor=#333333;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="4165" y="160" width="670" height="630" as="geometry" />
        </mxCell>
        <mxCell id="es-create-10" value="Inclusões e remoções se repetem, em qualquer ordem, até o orçamento ficar completo. Cada uma recalcula o orçamento." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bdbdbd;verticalAlign=bottom;align=center;spacingBottom=6;fontSize=13;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
