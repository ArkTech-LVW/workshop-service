        <mxCell id="ubiquitous-13" value="&lt;b style=&quot;font-size:18px&quot;&gt;Eventos de domínio com classe&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:12px&quot;&gt;Só os da OS viraram classe; os demais fatos ficam no agregado&lt;/i&gt;&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:12px;margin-top:8px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;text-align:left;border-bottom:2px solid #000000;padding:3px 4px;width:25%&quot;&gt;Termo&lt;/th&gt;&lt;th style=&quot;text-align:left;border-bottom:2px solid #000000;padding:3px 4px;width:28%&quot;&gt;Nome no código&lt;/th&gt;&lt;th style=&quot;text-align:left;border-bottom:2px solid #000000;padding:3px 4px;width:47%&quot;&gt;O que acontece depois&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Orçamento enviado&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;QuoteSentEvent&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;O estoque reserva as peças e o cliente é avisado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Orçamento aprovado&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;QuoteApprovedEvent&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;O estoque baixa as peças pela diferença e o cliente é avisado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Orçamento rejeitado&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;QuoteRejectedEvent&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;O estoque libera a reserva e o cliente é avisado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;Orçamento retirado&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;QuoteWithdrawnEvent&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;O estoque libera a reserva&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;OS finalizada&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;ServiceOrderCompletedEvent&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;O cliente é avisado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;OS cancelada&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;ServiceOrderCanceledEvent&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #cccccc;padding:3px 4px;vertical-align:top&quot;&gt;O estoque devolve as peças que saíram e libera a reserva&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="1">
