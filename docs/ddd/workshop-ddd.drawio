        </mxCell>
        <mxCell id="es-stock-220" parent="es-stock-219" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontStyle=1;spacingLeft=4;spacingTop=1;connectable=0;" value="EV" vertex="1">
