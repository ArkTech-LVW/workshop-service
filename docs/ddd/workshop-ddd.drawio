        <mxCell id="es-stock-92" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" value="2. Agregados e contextos delimitados" vertex="1">
