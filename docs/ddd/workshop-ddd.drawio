        <mxCell id="es-create-1" value="ES - Criação da OS" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="es-create-2" value="Do cliente chegando na oficina até o orçamento enviado para aprovação. O fluxo corre da esquerda para a direita; a notação está na aba Legenda." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="66" width="2000" height="30" as="geometry" />
