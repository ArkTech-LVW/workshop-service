        <mxCell id="tactical-85" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i style=&quot;font-size:10px&quot;&gt;«objeto de valor»&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Chassis&lt;/b&gt;&lt;/div&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Chassi (VIN) de 17 caracteres, com dígito verificador.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1">
