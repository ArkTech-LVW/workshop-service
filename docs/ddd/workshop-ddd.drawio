        <mxCell id="es-create-69" value="Ordem de Serviço" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#fff9b1;strokeColor=#b8a93a;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="2850" y="440" width="170" height="150" as="geometry" />
        </mxCell>
        <mxCell id="es-create-70" value="Peça removida" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#f5a623;strokeColor=#b97a00;" vertex="1" parent="1">
          <mxGeometry x="2850" y="620" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-71" value="• Mesmos status da inclusão.&lt;br&gt;• Item que não está na OS, 404.&lt;br&gt;• Serviço já concluído não sai (422)." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#8e44ad;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2380" y="830" width="640" height="190" as="geometry" />
        </mxCell>
        <mxCell id="es-create-72" value="Ordem de Serviço" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#fff9b1;strokeColor=#b8a93a;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="3190" y="440" width="170" height="150" as="geometry" />
        </mxCell>
        <mxCell id="es-create-73" value="Orçamento recalculado" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#f5a623;strokeColor=#b97a00;" vertex="1" parent="1">
          <mxGeometry x="3190" y="620" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-74" value="• Total: soma de quantidade vezes preço dos serviços e das peças.&lt;br&gt;• Recalculado no mesmo comando de cada inclusão ou remoção.&lt;br&gt;• Total máximo de R$ 9.999.999.999,99 (422)." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#8e44ad;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="3060" y="830" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="es-create-75" value="Itens e total da OS&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;GET /admin/serviceOrders/{id}&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#8bc34a;strokeColor=#558b2f;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="3530" y="200" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="es-create-76" value="Mecânico ou atendente" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#fff9b1;strokeColor=#b8a93a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="3410" y="320" width="100" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-77" value="Enviar orçamento&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;i&gt;SendQuoteUseCase&lt;/i&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#26c6da;strokeColor=#0097a7;" vertex="1" parent="1">
          <mxGeometry x="3530" y="320" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-78" value="Ordem de Serviço" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#fff9b1;strokeColor=#b8a93a;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="3530" y="440" width="170" height="150" as="geometry" />
        </mxCell>
        <mxCell id="es-create-79" value="&lt;b&gt;Orçamento enviado para aprovação&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;i&gt;status Aguardando aprovação&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b&gt;Classe QuoteSentEvent&lt;/b&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#f5a623;strokeColor=#5c3d00;strokeWidth=4;" vertex="1" parent="1">
          <mxGeometry x="3530" y="620" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-80" value="• Só a partir de Em diagnóstico.&lt;br&gt;• Precisa de pelo menos um item (422).&lt;br&gt;• &quot;Pode seguir sem as mudanças&quot; só vale no complementar (422).&lt;br&gt;• Vai para Aguardando aprovação, com registro no histórico." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#8e44ad;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="3400" y="830" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="es-create-81" value="Quando o orçamento é enviado, reservar as peças" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#c77dd9;strokeColor=#8e44ad;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="3800" y="320" width="120" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-82" value="Reservar peças da OS&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;i&gt;ReserveServiceOrderStockUseCase&lt;/i&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#26c6da;strokeColor=#0097a7;" vertex="1" parent="1">
          <mxGeometry x="3930" y="320" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-83" value="Peça e reserva" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#fff9b1;strokeColor=#b8a93a;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="3930" y="440" width="170" height="150" as="geometry" />
        </mxCell>
        <mxCell id="es-create-84" value="Peças reservadas para a OS" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#f5a623;strokeColor=#b97a00;" vertex="1" parent="1">
          <mxGeometry x="3930" y="620" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-85" value="• Reserva o que a OS pede menos o que já saiu do estoque para ela.&lt;br&gt;• Validade de 7 dias, renovada a cada envio.&lt;br&gt;• Sem disponível, o envio inteiro é desfeito e o cliente não é avisado (422)." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#8e44ad;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="3800" y="830" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="es-create-86" value="Quando o orçamento é enviado, avisar o cliente" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#c77dd9;strokeColor=#8e44ad;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="4180" y="320" width="120" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-87" value="Registrar aviso ao cliente&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;i&gt;contrato Notifier&lt;/i&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#26c6da;strokeColor=#0097a7;" vertex="1" parent="1">
          <mxGeometry x="4310" y="320" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-88" value="Notificação por e-mail" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#fff9b1;strokeColor=#b8a93a;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="4310" y="440" width="170" height="150" as="geometry" />
        </mxCell>
        <mxCell id="es-create-89" value="Aviso do orçamento registrado" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#f5a623;strokeColor=#b97a00;" vertex="1" parent="1">
          <mxGeometry x="4310" y="620" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-90" value="• Registrado na mesma transação do envio.&lt;br&gt;• Vai para o e-mail do cadastro do cliente.&lt;br&gt;• Leva o código da OS e o total do orçamento." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#8e44ad;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="4180" y="830" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="es-create-91" value="Registrar o aviso não tem caso de uso próprio: o ouvinte da OS chama direto o contrato de notificação." style="rhombus;whiteSpace=wrap;html=1;fillColor=#f08080;strokeColor=#b85450;fontSize=11;spacingLeft=52;spacingRight=52;" vertex="1" parent="1">
          <mxGeometry x="4180" y="1050" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="es-create-92" value="A cada 30 segundos, enviar os e-mails pendentes" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#c77dd9;strokeColor=#8e44ad;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="4520" y="320" width="120" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-93" value="Enviar e-mails pendentes&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;i&gt;SendPendingEmailsUseCase&lt;/i&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#26c6da;strokeColor=#0097a7;" vertex="1" parent="1">
          <mxGeometry x="4650" y="320" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-94" value="Notificação por e-mail" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#fff9b1;strokeColor=#b8a93a;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="4650" y="440" width="170" height="150" as="geometry" />
        </mxCell>
        <mxCell id="es-create-95" value="E-mail do orçamento enviado" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fillColor=#f5a623;strokeColor=#b97a00;" vertex="1" parent="1">
          <mxGeometry x="4650" y="620" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="es-create-96" value="• Até 50 e-mails por vez.&lt;br&gt;• Na falha, tenta de novo depois de 1 minuto, até 5 tentativas." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#8e44ad;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=10;fontSize=12;" vertex="1" parent="1">
