{
  "info": {
    "_postman_id": "9d2d11aa-e07b-478d-b822-64df8f431850",
    "name": "Workshop Service",
    "description": "Rotas da API do workshop-service. Rode a aplicação com `./gradlew bootRun` e comece por **Autenticação → Autentica um usuário**: o token da resposta fica em `{{accessToken}}`, e todas as outras rotas já o enviam como Bearer.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string",
      "description": "Endereço da aplicação rodando localmente"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string",
      "description": "Preenchido pelo login; deixe vazio antes de exportar"
    }
  ],
  "item": [
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "Autentica um usuário",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('accessToken', pm.response.json().accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@workshop.local\",\n  \"password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Clientes",
      "description": "Rotas de `/admin/customers`, só para ADMIN.",
      "item": [
        {
          "name": "Cadastra um cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Souza\",\n  \"document\": \"529.982.247-25\",\n  \"email\": \"ana.souza@email.com\",\n  \"phone\": \"(11) 98765-4321\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/customers",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "customers"]
            }
          }
        },
        {
          "name": "Lista os clientes",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/customers?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "customers"],
              "query": [
                {
                  "key": "page",
                  "value": "0",
                  "description": "Número da página, começando em 0"
                },
                {
                  "key": "size",
                  "value": "20",
                  "description": "Itens por página, de 1 a 100"
                }
              ]
            }
          }
        },
        {
          "name": "Busca um cliente pelo CPF ou CNPJ",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/customers?document=529.982.247-25",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "customers"],
              "query": [
                {
                  "key": "document",
                  "value": "529.982.247-25",
                  "description": "CPF ou CNPJ, com ou sem máscara"
                }
              ]
            }
          }
        },
        {
          "name": "Busca um cliente",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/customers/:id",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "customers", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "Id devolvido pelo cadastro"
                }
              ]
            }
          }
        },
        {
          "name": "Atualiza os dados de um cliente",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Souza Oliveira\",\n  \"document\": \"529.982.247-25\",\n  \"email\": \"ana.oliveira@email.com\",\n  \"phone\": \"(11) 98765-4321\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/customers/:id",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "customers", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "Id devolvido pelo cadastro"
                }
              ]
            }
          }
        },
        {
          "name": "Exclui um cliente",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/admin/customers/:id",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "customers", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "Id devolvido pelo cadastro"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
